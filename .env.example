# ============================================================
# Nginx Gateway Global Environment Variable Template
# Copy this file to .env and fill in your actual values
#   cp .env.template .env
# ============================================================

# ---------- General ----------
TIMEZONE=Asia/Shanghai

# ---------- FRP ----------
# FRP server address
FRP_SERVER_ADDR=your-frp-server.com

# FRP server port (default: 7000)
FRP_SERVER_PORT=7000

# FRP auth token
FRP_AUTH_TOKEN=your-token-here

# Custom domains (TOML array format, e.g. "domain1.com", "domain2.com")
FRP_CUSTOM_DOMAINS="your-domain.com"
