# FRP Client config — generated from .env, do not edit directly
serverAddr = "${FRP_SERVER_ADDR}"
serverPort = ${FRP_SERVER_PORT}

auth.method = "token"
auth.token = "${FRP_AUTH_TOKEN}"

# Transport layer heartbeat and multiplexing configuration
[transport]
# Global connection timeout (seconds)
dialServerTimeout = 30
# Heartbeat interval (seconds)
heartbeatInterval = 30
# Heartbeat timeout (seconds), must be greater than heartbeatInterval
heartbeatTimeout = 60
# Enable TCP multiplexing to reduce connection overhead
tcpMux = true

[[proxies]]
name = "nginx-gateway"
type = "http"
localIP = "127.0.0.1"
localPort = 80
customDomains = ["${FRP_SERVER_ADDR}"]

[[proxies]]
name = "zenportal"
type = "http"
localIP = "127.0.0.1"
localPort = 80
subdomain = "zenportal"
